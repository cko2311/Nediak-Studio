---
interface Props {
  text: string; // The button text
  url: string; // The link destination
  target?: string; // Optional: open in new tab
  isActive?: boolean; // New: Boolean to indicate if this link is for the current page
}

const { text, url, target = "_self", isActive = false } = Astro.props;
---

<a
  href={url}
  target={target}
  data-button-animate
  class="group bg-brand text-light flex w-fit items-center gap-3 rounded-md px-3 py-3 text-sm outline-none transition-all focus:ring-2 focus:ring-light"
>
  <span class="relative h-4 overflow-hidden flex items-center">
    <span class="relative block">
      <span class="h-4 flex items-center transition-transform duration-300 group-hover:-translate-y-4 font-medium">
        {text}
      </span>
      <span class="absolute top-0 left-0 h-4 flex items-center translate-y-4 transition-transform duration-300 group-hover:translate-y-0 font-medium">
        {text}
      </span>
    </span>
  </span>

  <div
    class="border-light size-2 shrink-0 rounded-full border transition-all duration-300 group-hover:bg-light group-hover:scale-110"
    aria-hidden="true"
  ></div>
</a>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap";

  let ctx: gsap.Context | undefined;

  const initButtonAnimation = () => {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const buttons = document.querySelectorAll<HTMLElement>(
        "[data-button-animate]"
      );

      buttons.forEach((btn) => {
        gsap.fromTo(
          btn,
          { autoAlpha: 0 },
          {
            autoAlpha: 1,
            duration: 0.35,
            ease: "expo.inOut",
            clearProps: "opacity,visibility",
            scrollTrigger: {
              trigger: btn,
              start: "top 90%",
              once: true
            }
          }
        );
      });
    });

    ScrollTrigger.refresh();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initButtonAnimation);
  } else {
    initButtonAnimation();
  }

  document.addEventListener("astro:page-load", initButtonAnimation);
</script>

---
import { Image } from "astro:assets";
import { type ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: containerClass = "h-auto w-full",
} = Astro.props;
---

<div data-reveal-container class={`overflow-hidden ${containerClass}`}>
  <Image
    src={src}
    width={width}
    height={height}
    alt={alt}
    fit="cover"
    loading="lazy"
    data-image-animate
    class="h-full w-full rounded-md"
  />
</div>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap";

  let ctx: gsap.Context | undefined;

  const initImageReveal = () => {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      // Select all image containers using the new attribute
      const containers = document.querySelectorAll<HTMLElement>("[data-reveal-container]");

      containers.forEach((container) => {
        const image = container.querySelector("[data-image-animate]");

        if (image) {
          // Define the starting (hidden) and ending (revealed) clip-path polygons
          const clipPathStart = "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)"; // Hidden at top edge
          const clipPathEnd = "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)"; // Fully revealed

          // Set the initial clip-path for the animation start
          gsap.set(container, {
            clipPath: clipPathStart,
            willChange: "clip-path",
          });

          // Create the ScrollTrigger animation
          gsap.to(container, {
            clipPath: clipPathEnd,
            duration: 1.25,
            delay: 0.75,
            ease: "power2.inOut",
            scrollTrigger: {
              trigger: container,
              start: "top 85%",
              end: "bottom 20%",
            },
          });
        }
      });
    });

    ScrollTrigger.refresh();
  };

  const init = () => {
    initImageReveal();
  };

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>


---
interface Props {
  as?: "p" | "a" | "div" | "span";
  href?: string;
  class?: string;
  indent?: boolean;
}

const { as = "p", href, class: className, indent = false } = Astro.props;
const Tag = as;
---

{
  as === "a" ? (
    <a
      href={href}
      data-copy-animate
      class="opacity-0"
      class:list={[className]}
      aria-hidden="true"
    >
      {indent && <span class="indent-spacer" aria-hidden="true" />}
      <slot />
    </a>
  ) : (
    <Tag
      data-copy-animate
      class="opacity-0"
      class:list={[className]}
      aria-hidden="true"
    >
      {indent && <span class="indent-spacer" aria-hidden="true" />}
      <slot />
    </Tag>
  )
}

<slot name="sr" />

<style>
  [data-copy-animate] {
    font-kerning: none;
    text-rendering: optimizeSpeed;
    display: block;
    will-change: transform;
  }

  .indent-spacer {
    display: none;
  }

  @media (min-width: 1040px) {
    .indent-spacer {
      display: inline-block;
      width: 10rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { gsap, SplitText, ScrollTrigger } from "@/lib/gsap";

  let ctx: gsap.Context | undefined;

  const runAnimation = () => {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const elements = gsap.utils.toArray<HTMLElement>("[data-copy-animate]");

      elements.forEach((element) => {
        const split = SplitText.create(element, {
          types: "lines",
          mask: "lines",
          linesClass: "line",
          autoSplit: true,
          onSplit: (self) => {
            gsap.set(self.lines, { yPercent: 200 });
            element.classList.remove("opacity-0");

            const tween = gsap.to(self.lines, {
              scrollTrigger: {
                trigger: element,
                start: "top 80%",
              },
              yPercent: 0,
              duration: 1.5,
              ease: "expo.out",
              stagger: 0.075,
            });

            return tween;
          },
        });
      });
    });

    ScrollTrigger.refresh();
  };

  const init = () => {
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(runAnimation);
    } else {
      runAnimation();
    }
  };

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>



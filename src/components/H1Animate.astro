---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
  isHome?: boolean;
}

const { level = 1, class: className, isHome = false } = Astro.props;
const Tag = `h${level}`;

const animationDelay = isHome ? 1.2 : 0.75;
---

<Tag class={`relative ${className || ""}`}>
  <!-- Animated visual text (decorative only) -->
  <span
    data-heading-load
    data-delay={animationDelay}
    style="opacity:0;visibility:hidden"
    aria-hidden="true"
  >
    <slot />
  </span>

  <!-- Accessible static text for screen readers -->
  <slot name="sr" />
</Tag>

<style>
  [data-heading-load] {
    display: block;
    overflow: hidden;
    font-kerning: none;
    text-rendering: optimizeSpeed;
    will-change: transform;
  }

  :global(.lineParent) {
    overflow-y: hidden !important; /* Keeps the vertical slide-up mask */
    overflow-x: visible !important; /* Allows horizontal glyph overhang */
    width: 100% !important; /* Defeats GSAP's strict inline width */
  }

  /* Screen-reader only version */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { gsap, SplitText, DURATION, EASE } from "@/lib/gsap";

  let ctx: gsap.Context | undefined;

  const runHeroAnimation = () => {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const elements = gsap.utils.toArray<HTMLElement>("[data-heading-load]");

      elements.forEach((element) => {
        const delay = parseFloat(element.dataset.delay || "0");

        gsap.set(element, { opacity: 1, visibility: "visible" });

        const split = new SplitText(element, {
          types: "lines",
          mask: "lines",
          linesClass: "lineParent",
          autoSplit: true,
        });

        new SplitText(element, {
          types: "lines",
          mask: "lines",
          linesClass: "lineChild",
        });

        const lines = element.querySelectorAll(".lineChild");

        gsap.set(lines, {
          yPercent: 200,
          autoAlpha: 0,
        });

        gsap.to(lines, {
          yPercent: 0,
          autoAlpha: 1,
          duration: DURATION,
          ease: "expo.out",
          stagger: 0.075,
          delay: delay,
        });
      });
    });
  };

  document.addEventListener("DOMContentLoaded", () => {
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(runHeroAnimation);
    } else {
      runHeroAnimation();
    }
  });
</script>


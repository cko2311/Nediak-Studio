---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
  isHome?: boolean; // 1. Add the new prop
}

const { level = 1, class: className, isHome = false } = Astro.props;
const Tag = `h${level}`;

// 2. Define the delays dynamically based on whether it's the home page
const animationDelay = isHome ? 1.2 : 0.75;
---

<!-- 3. Pass the delay value to the client using a data attribute -->
<Tag 
  class={`hero-heading relative ${className || ""}`}
  data-delay={animationDelay}
>
  <!-- Animated visual text (decorative only) -->
  <span
    class="hero-split-heading"
    style="opacity:0;visibility:hidden"
    aria-hidden="true"
  >
    <slot />
  </span>

  <!-- Accessible static text for screen readers -->
  <slot name="sr" />
</Tag>

<style>
  .hero-heading {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .hero-split-heading span {
    display: inline-block;
    font-kerning: none;
    text-rendering: optimizeSpeed;
    opacity: 0;
    visibility: hidden;
    will-change: transform;
  }

  /* Screen-reader only version */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { gsap, SplitText, DURATION, EASE } from "@/lib/gsap";

  let ctx;

  const runHeroAnimation = () => {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const headings = gsap.utils.toArray(".hero-heading");

      headings.forEach((heading: any) => {
        // 4. Read the specific delay configured on this heading instance
        const delay = parseFloat(heading.dataset.delay || "0");
        const element = heading.querySelector(".hero-split-heading");

        if (!element) return;

        gsap.set(element, { opacity: 1, visibility: "visible" });

        const split = new SplitText(element, {
          types: "lines",
          mask: "lines",
          linesClass: "lineParent",
          autoSplit: true,
        });

        new SplitText(element, {
          types: "lines",
          mask: "lines",
          linesClass: "lineChild",
        });

        // Scope line selection to this specific heading to prevent cross-contamination if multiple exist
        const lines = heading.querySelectorAll(".lineChild");

        gsap.set(lines, {
          yPercent: 200,
          autoAlpha: 0,
        });

        gsap.to(lines, {
          yPercent: 0,
          autoAlpha: 1,
          duration: DURATION,
          ease: "expo.out",
          stagger: 0.075,
          delay: delay, // 5. Apply the dynamic delay here
        });
      });
    });
  };

  document.addEventListener("DOMContentLoaded", () => {
    document.fonts.ready.then(runHeroAnimation);
  });
</script>


---
import Layout from "@/layouts/Layout.astro";
import H1Animate from "@/components/H1Animate.astro";

interface Props {
  companyName?: string;
  websiteUrl?: string;
  contactEmail?: string;
  effectiveDate?: string;
}

const {
  companyName = "Nediak Studio",
  websiteUrl = "https://www.nediakstudio.com",
  contactEmail = "info@nediakstudio.com",
  effectiveDate = "November 25, 2026"
} = Astro.props;

const pageCanonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const seoProps = {
  title: "Privacy | Nediak Studio",
  description: "Nediak Studio privacy policy",
  canonical: pageCanonicalUrl
};
---

<Layout seo={seoProps}>
  <section class="w-full h-svh flex justify-center items-center">
    <div class="px-fluid-md md:px-fluid-xl z-3 w-full space-y-fluid-xl">
      <div>
        <H1Animate class="text-fluid-7xl text-center">Privacy Policy</H1Animate>
      </div>
      <div class="space-y-fluid-md">
        <p>
          <b>Effective Date: </b>
          {effectiveDate}
        </p>

        <p>
          <span class="font-medium">{companyName} </span>(“we,” “our,” or “us”)
          respects your privacy and is committed to protecting the personal
          information provided through our website. This Privacy Policy explains
          what information is collected, how it is used, how it is shared, and
          your rights regarding your information.
        </p>

        <p>
          This Privacy Policy applies only to information collected through{" "}
          <a href={websiteUrl} class="text-brand">
            www.nediakstudio.com
          </a>{" "}
          (the “Website”).
        </p>
      </div>
    </div>
  </section>
  <section class="pb-fluid-3xl">
    <div class="px-fluid-md md:px-fluid-xl space-y-fluid-xl">
      <div class="privacy-inner">
        <h2>1. Information We Collect</h2>
        <p>
          Depending on how you interact with our Website, we may collect the
          following information.
        </p>

        <h3>Information You Voluntarily Provide</h3>
        <p>
          When you complete a project inquiry or contact form, we may collect:
        </p>
        <ul>
          <li>Full name</li>
          <li>Email address</li>
          <li>Phone number</li>
          <li>Project details and specifications</li>
          <li>Additional comments or information you choose to provide</li>
        </ul>
        <p>
          Please avoid submitting unnecessary confidential or highly sensitive
          information through website contact forms unless specifically
          requested.
        </p>

        <h3>Automatically Collected Information</h3>
        <p>
          When you visit our Website, certain technical information may be
          collected automatically, including:
        </p>
        <ul>
          <li>IP address</li>
          <li>Browser type</li>
          <li>Device information</li>
          <li>Operating system</li>
          <li>Pages viewed</li>
          <li>Time spent on pages</li>
          <li>Referring website</li>
          <li>Website interactions</li>
          <li>General geographic location (city or region)</li>
          <li>Website performance and diagnostic information</li>
        </ul>
      </div>

      <div class="privacy-inner">
        <h2>2. How We Use Your Information</h2>
        <p>We may use your information to:</p>
        <ul>
          <li>Respond to inquiries</li>
          <li>Schedule or manage consultations</li>
          <li>Verify identity when appropriate</li>
          <li>Provide requested design and development services</li>
          <li>Improve our Website and monitor its performance</li>
          <li>Maintain Website security</li>
          <li>Comply with legal obligations</li>
          <li>Respond to lawful requests from governmental authorities</li>
        </ul>
        <p>We do not sell, rent, or trade your personal information.</p>
      </div>

      <div class="privacy-inner">
        <h2>3. Consultation Requests and Scheduling Platforms</h2>
        <p>
          Our Website may use embedded forms, consultation scheduling tools, and
          secure client portals provided by third-party scheduling platforms
          (such as Cal.com or similar scheduling software).
        </p>
        <p>
          When you submit information through these forms or use the client
          portal, your information may be transmitted directly to the platform
          for consultation scheduling, communication, and project management.
        </p>
        <p>
          Information submitted through these tools is governed by their
          respective privacy and security practices in addition to this Privacy
          Policy.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>4. Analytics Services</h2>
        <p>
          We use analytics tools (such as Google Analytics 4) to understand how
          visitors interact with our Website.
        </p>
        <p>These tools may collect information including:</p>
        <ul>
          <li>Pages visited and time spent on pages</li>
          <li>Device type and browser information</li>
          <li>Approximate geographic location and referral sources</li>
          <li>
            Enhanced Measurement events (such as page views, scrolls, outbound
            clicks, file downloads, site search, and video engagement)
          </li>
        </ul>
        <p>
          This information is used solely to analyze Website traffic, improve
          performance, and enhance the user experience. We do not use analytics
          data to identify individual visitors.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>5. Embedded Content and Third-Party Services</h2>
        <p>
          Our Website may include content or services provided by trusted third
          parties, such as video platforms or social media widgets.
        </p>
        <p>
          These providers may collect information according to their own privacy
          policies when you interact with their embedded content or services.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>6. Cookies and Similar Technologies</h2>
        <p>Our Website uses cookies and similar technologies to:</p>
        <ul>
          <li>Improve Website functionality</li>
          <li>Analyze Website traffic</li>
          <li>Maintain Website security</li>
          <li>Remember certain Website preferences</li>
        </ul>
        <p>
          Most web browsers allow you to manage or disable cookies through your
          browser settings. Please note that disabling cookies may affect
          certain Website features.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>7. How We Share Information</h2>
        <p>We do not sell, rent, or trade your personal information.</p>
        <p>
          We may share information only when necessary with trusted service
          providers who assist us in operating our Website or providing our
          services, including:
        </p>
        <ul>
          <li>Scheduling and communication software providers</li>
          <li>Analytics providers</li>
          <li>Website hosting and maintenance providers</li>
          <li>
            Form processing, email delivery, and project management software
            providers
          </li>
        </ul>
        <p>
          We may also disclose information when required by law or when
          necessary to protect our legal rights or the safety of others.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>8. Data Security</h2>
        <p>
          We use commercially reasonable administrative, technical, and physical
          safeguards to protect information collected through our Website.
        </p>
        <p>These measures include:</p>
        <ul>
          <li>HTTPS encryption</li>
          <li>Secure website hosting</li>
          <li>Restricted administrative access</li>
          <li>Industry-standard security practices where appropriate</li>
        </ul>
        <p>
          While we strive to protect your information, no method of electronic
          transmission or storage is completely secure, and we cannot guarantee
          absolute security.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>9. Data Retention</h2>
        <p>
          We retain personal information only as long as reasonably necessary
          to:
        </p>
        <ul>
          <li>Respond to inquiries and schedule consultations</li>
          <li>Meet legal and regulatory obligations</li>
          <li>Maintain appropriate business records and resolve disputes</li>
        </ul>
        <p>
          Information maintained within client portals or project management
          software is retained according to applicable business and professional
          recordkeeping requirements.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>10. Adult Use Only</h2>
        <p>Our Website is intended for adults.</p>
        <p>
          We do not knowingly collect personal information from individuals
          under the age of 18.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>11. Links to Other Websites</h2>
        <p>Our Website may contain links to third-party websites.</p>
        <p>
          We are not responsible for the privacy practices, content, or security
          of those websites, and we encourage you to review their privacy
          policies before providing personal information.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>12. Your Privacy Rights</h2>
        <p>Depending on applicable law, you may have the right to:</p>
        <ul>
          <li>Request access to your personal information</li>
          <li>Request correction of inaccurate information</li>
          <li>Request deletion of certain information</li>
          <li>Ask questions regarding our privacy practices</li>
        </ul>
        <p>To submit a privacy request, please contact us at:</p>
        <p>
          <b>Email: </b>
          <a href="mailto:info@nediakstudio.com" class="font-medium text-brand">
            {contactEmail}
          </a>
        </p>
      </div>

      <div class="privacy-inner">
        <h2>13. Changes to This Privacy Policy</h2>
        <p>We may update this Privacy Policy from time to time.</p>
        <p>
          Any revisions will be posted on this page with a revised Effective
          Date. Your continued use of the Website after changes become effective
          constitutes acceptance of the updated Privacy Policy.
        </p>
      </div>

      <div class="privacy-inner">
        <h2>14. Contact Us</h2>
        <p class="font-medium">{companyName}, all rights reserved</p>
        <p>
          Website:{" "}
          <a href={websiteUrl} class="font-medium text-brand">
            www.nediakstudio.com
          </a>
        </p>
        <p>
          Email:{" "}
          <a href="mailto:info@nediakstudio.com" class="font-medium text-brand">
            {contactEmail}
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>

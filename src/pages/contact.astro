---
import Layout from "@/layouts/Layout.astro";
import H1Animate from "@/components/H1Animate.astro";
import HeroCopyAnimate from "@/components/HeroCopyAnimate.astro";
import ScrollHtagAnimate from "@/components/ScrollHtagAnimate.astro";
const pageCanonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const seoProps = {
  title: "Contact | Nediak Studio",
  description:
    "Contact Nediak Studio if you are looking for a website, branding, or search engine optimization for your business.",
  canonical: pageCanonicalUrl
};
---

<Layout seo={seoProps}>
  <section class="w-full h-svh grid place-items-center relative">
    <div class="space-y-10 px-fluid-md md:px-fluid-xl z-3 w-full">
      <div>
        <H1Animate class="text-fluid-7xl max-w-[11ch] md:max-w-[15ch] uppercase"
          >Have a Project? <span class="text-dark/60">Lets Connect</span>
          <span slot="sr" class="sr-only"> Have a Project? Let's Connect </span>
        </H1Animate>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12">
        <div
          class="col-span-full md:col-start-7 md:col-end-13 lg:col-start-8 overflow-clip"
        >
          <HeroCopyAnimate class="w-full md:w-[23ch] text-fluid-2xl p-large">
            Start the conversation on your new project or collaboration.
          </HeroCopyAnimate>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="px-fluid-md md:px-fluid-xl w-full space-y-8">
      <div class="w-fit mx-auto">
        <ScrollHtagAnimate class="text-center w-[13ch]">
          Book A Call Today To Get Started
        </ScrollHtagAnimate>
      </div>
      <div class="w-full" id="my-cal-inline-introduction"></div>
    </div>
  </section>
  <section class="py-fluid-3xl">
    <div class="px-fluid-md md:px-fluid-xl w-full">
      <div>
        <div class="border-t border-t-neutral py-fluid-sm font-medium">
          <a
            href="mailto:info@nediakstudio.com"
            class="contact-link text-fluid-4xl hover:text-brand after:bg-brand relative inline-block w-fit transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-[calc(100%-1px)] after:origin-right after:scale-x-0 after:transition-transform after:duration-400 after:ease-in after:content-[''] hover:after:origin-left hover:after:scale-x-100"
            >info@nediakstudio.com</a
          >
        </div>
        <div class="border-t border-t-neutral py-fluid-sm font-medium">
          <a
            href="tel:+1-732-378-9883"
            class="contact-link text-fluid-4xl hover:text-brand after:bg-brand relative inline-block w-fit transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-[calc(100%-1px)] after:origin-right after:scale-x-0 after:transition-transform after:duration-400 after:ease-in after:content-[''] hover:after:origin-left hover:after:scale-x-100"
            >732-378-9883</a
          >
        </div>
        <div class="border-t border-t-neutral py-fluid-sm font-medium">
          <a
            href="https://x.com/nediakstudio"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link text-fluid-4xl hover:text-brand after:bg-brand relative inline-block w-fit transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-[calc(100%-1px)] after:origin-right after:scale-x-0 after:transition-transform after:duration-400 after:ease-in after:content-[''] hover:after:origin-left hover:after:scale-x-100"
            >X(Twitter)</a
          >
        </div>
        <div class="border-y border-y-neutral py-fluid-sm font-medium">
          <a
            href="https://www.instagram.com/nediakstudio/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link text-fluid-4xl hover:text-brand after:bg-brand relative inline-block w-fit transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-[calc(100%-1px)] after:origin-right after:scale-x-0 after:transition-transform after:duration-400 after:ease-in after:content-[''] hover:after:origin-left hover:after:scale-x-100"
            >Instagram</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<script type="text/javascript">
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "introduction", { origin: "https://app.cal.com" });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;

  Cal.ns.introduction("inline", {
    elementOrSelector: "#my-cal-inline-introduction",
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
    calLink: "christopher-ko-7xgngm/introduction"
  });

  Cal.ns.introduction("ui", {
    cssVarsPerTheme: {
      light: { "cal-brand": "#171717" },
      dark: { "cal-brand": "#a1ff62" }
    },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>
<!-- Cal inline embed code ends -->
